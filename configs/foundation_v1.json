{
  "architecture": "baby_v010_foundation_v1",
  "initialization": "pytorch_module_defaults_v1",
  "vocab_size": 1024,
  "context_length": 256,
  "d_model": 640,
  "n_heads": 10,
  "n_layers": 12,
  "d_mlp": 2560,
  "activation": "relu",
  "embedding_dropout": 0.05,
  "attention_dropout": 0.05,
  "residual_dropout": 0.05,
  "norm_type": "explicit_layer_norm",
  "norm_epsilon": 0.00001,
  "norm_placement": "pre_norm",
  "position_method": "learned_absolute",
  "tie_embeddings": false,
  "attention_backend": "sdpa",
  "qkv_bias": false,
  "attention_output_bias": true,
  "mlp_bias": true,
  "lm_head_bias": true,
  "binding": {
    "enabled": false,
    "num_slots": 2,
    "retrieval_dim": 128,
    "localizer": "orthogonal_two_slot",
    "localizer_initialization": "normal_std_d_model_neg_half",
    "layout_interface": "explicit_key_value_positions_v1"
  }
}
