__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated data, metrics, and model artifacts
runs/*
checkpoints/*
evaluations/generated/*
data/generated/*
*.pt
*.pth
*.npz
*.u16
*.u32
*.safetensors
*.bin

# Keep directory placeholders and frozen protocol receipts tracked
!runs/.gitkeep
!checkpoints/.gitkeep
!evaluations/generated/.gitkeep
!data/generated/.gitkeep

# v2R4 isolation diagnostic receipts (JSON/MD only; not checkpoints)
!runs/v2r4_isolation_autopsy/
!runs/v2r4_isolation_autopsy/**
!runs/v2r4_isolation_probe/
!runs/v2r4_isolation_probe/**
!runs/v2r4_isolation_panels/
!runs/v2r4_isolation_panels/ISOLATION_META.json

# Query-locality probe summary (JSON only; per-row dumps stay local and hashed)
!runs/query_locality/
!runs/query_locality/QUERY_LOCALITY.json
runs/query_locality/ROWS_*.json
!runs/query_locality_t1/
!runs/query_locality_t1/QUERY_LOCALITY.json
runs/query_locality_t1/ROWS_*.json

# D1 query-presence (summaries git; pair dumps local and hashed)
!runs/query_presence_d1/
!runs/query_presence_d1/QUERY_PRESENCE.json
!runs/query_presence_d1/ADJUDICATION.json
runs/query_presence_d1/ROWS_*.json

# D1b query-presence (manifest + diagnostic + summaries git; pair dumps local)
!runs/query_presence_d1b/
!runs/query_presence_d1b/MANIFEST.json
!runs/query_presence_d1b/DIAGNOSTIC.json
!runs/query_presence_d1b/QUERY_PRESENCE.json
!runs/query_presence_d1b/ADJUDICATION.json
runs/query_presence_d1b/ROWS_*.json

# T1 receipts (manifest + adjudication only; schedules and checkpoints stay local)
!runs/selection_t1/
!runs/selection_t1/MANIFEST.json
!runs/selection_t1/ADJUDICATION_130001_400.json
runs/selection_t1/SCHEDULE_*.json
runs/selection_t1/*/

# P1 pointer-attention (manifest + adjudication git; schedules/checkpoints local)
!runs/selection_p1/
!runs/selection_p1/MANIFEST.json
runs/selection_p1/SCHEDULE_*.json
runs/selection_p1/*/
!runs/selection_p1/ADJUDICATION_*.json

# P2 residual-bind (manifest + adjudication git; schedules/checkpoints local)
!runs/selection_p2/
!runs/selection_p2/MANIFEST.json
runs/selection_p2/SCHEDULE_*.json
runs/selection_p2/*/
!runs/selection_p2/ADJUDICATION_*.json

# D3 residual splice (summaries git)
!runs/query_splice_d3/
!runs/query_splice_d3/MANIFEST.json
!runs/query_splice_d3/QUERY_SPLICE.json
!runs/query_splice_d3/ADJUDICATION.json

# D3b L0 control decomposition
!runs/query_splice_d3b/
!runs/query_splice_d3b/MANIFEST.json
!runs/query_splice_d3b/QUERY_SPLICE.json
!runs/query_splice_d3b/ADJUDICATION.json

# P3 early residual-bind (manifest + adjudication git; schedules/checkpoints local)
!runs/selection_p3/
!runs/selection_p3/MANIFEST.json
runs/selection_p3/SCHEDULE_*.json
runs/selection_p3/*/
!runs/selection_p3/ADJUDICATION_*.json

# P4 direct L0 copy (manifest + adjudication git; schedules/checkpoints local)
!runs/selection_p4/
!runs/selection_p4/MANIFEST.json
runs/selection_p4/SCHEDULE_*.json
runs/selection_p4/*/
!runs/selection_p4/ADJUDICATION_*.json

# D2 query-presence on P1 checkpoints (summaries git; pair dumps local)
!runs/query_presence_d2/
!runs/query_presence_d2/MANIFEST.json
!runs/query_presence_d2/ADJUDICATION.json
!runs/query_presence_d2/treatment/
!runs/query_presence_d2/treatment/QUERY_PRESENCE.json
!runs/query_presence_d2/treatment/ADJUDICATION.json
!runs/query_presence_d2/control/
!runs/query_presence_d2/control/QUERY_PRESENCE.json
!runs/query_presence_d2/control/ADJUDICATION.json
runs/query_presence_d2/**/ROWS_*.json

